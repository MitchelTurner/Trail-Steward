    "@nestjs/throttler": "^6.3.0",
    "@react-pdf/renderer": "^4.1.6",
    "bullmq": "^5.34.8",
    "cookie-parser": "^1.4.7",
    "db": "workspace:*",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.2.0",
    "nestjs-zod": "^4.3.1",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
