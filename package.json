{
  "name": "trail-steward",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "node scripts/ensure-services.mjs && turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter db exec prisma migrate dev",
    "db:deploy": "pnpm --filter db exec prisma migrate deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
