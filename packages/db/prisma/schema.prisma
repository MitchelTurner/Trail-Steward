generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Railway's image is Debian. Prisma's query engine needs the OpenSSL 3 build.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum OrgKind {
  FEDERAL
  STATE
  LOCAL_GOVERNMENT
  TRIBAL_GOVERNMENT
  NATIVE_CORPORATION
  STATE_LAND_TRUST
  UNIVERSITY
  NONPROFIT
  COALITION
  REGIONAL_ORG
  ADVISORY_BODY
  BUSINESS
  PRIVATE_LANDOWNER
  OTHER
}

enum UserRole {
  EDITOR
  COORDINATOR
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LinkStatus {
  UNCHECKED
  OK
  REDIRECT
  BROKEN
}

enum SuggestionStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum Visibility {
  PUBLIC
  PARTNERS
  PRIVATE
}

model Organization {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  shortName    String?
  kind         OrgKind
  websiteUrl   String?
  description  String?
  communities  String[]
  isGroup      Boolean    @default(false)
  visibility   Visibility @default(PUBLIC)
  contactName  String?
  contactEmail String?
  contactPhone String?
  status       ContentStatus @default(PUBLISHED)

  maintainerId       String?
  maintainer         User?   @relation("OrgMaintainer", fields: [maintainerId], references: [id])
  reviewedAt         DateTime?
  reviewIntervalDays Int     @default(365)

  members   User[]       @relation("OrgMembers")
  roles     PlayerRole[]
  resources Resource[]   @relation("ResourceOwner")
  stewardedTrails  Trail[] @relation("TrailDataSteward")
  maintainedTrails Trail[] @relation("TrailMaintenanceOwner")
  ownedIssues      Issue[] @relation("IssueOwner")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Topic {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  question  String
  sortOrder Int

  learnings TopicLearning[]
  roleTypes RoleType[]
  roles     PlayerRole[]
}

model TopicLearning {
  id        String @id @default(cuid())
  topicId   String
  topic     Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  heading   String
  body      String
  sortOrder Int
}

model RoleType {
  id         String @id @default(cuid())
  topicId    String
  topic      Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name       String
  definition String
  sortOrder  Int

  @@unique([topicId, name])
}

/// One row of a topic sheet's "What each player shared" table.
model PlayerRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  roleLabel      String
  roleTypeNames  String[]
  roleQualifier  String?
  isDocumented   Boolean      @default(true)
  hasRole        Boolean      @default(true)
  resourcesText  String?
  needsText      String?
  status         ContentStatus @default(PUBLISHED)

  maintainerId       String?
  maintainer         User?     @relation("RoleMaintainer", fields: [maintainerId], references: [id])
  reviewedAt         DateTime?
  reviewIntervalDays Int       @default(365)

  resources   Resource[] @relation("RoleResources")
  sourceSheet String
  sourceRow   Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([organizationId, topicId])
}

model Resource {
  id          String        @id @default(cuid())
  title       String
  url         String
  kind        String
  description String?
  ownerOrgId  String?
  ownerOrg    Organization? @relation("ResourceOwner", fields: [ownerOrgId], references: [id])
  roles       PlayerRole[]  @relation("RoleResources")
  stepLinks   StepResource[]

  linkStatus     LinkStatus @default(UNCHECKED)
  linkCheckedAt  DateTime?
  linkFinalUrl   String?
  linkHttpStatus Int?

  maintainerId       String?
  maintainer         User?     @relation("ResourceMaintainer", fields: [maintainerId], references: [id])
  reviewedAt         DateTime?
  reviewIntervalDays Int       @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([url, title])
}

model Pathway {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  summary   String
  status    ContentStatus @default(DRAFT)
  questions Json
  steps     PathwayStep[]
  version   Int           @default(1)
  // Back-relation required by Checklist.pathway.
  checklists Checklist[]

  maintainerId       String?
  maintainer         User?     @relation("PathwayMaintainer", fields: [maintainerId], references: [id])
  reviewedAt         DateTime?
  reviewIntervalDays Int       @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PathwayStep {
  id               String   @id @default(cuid())
  pathwayId        String
  pathway          Pathway  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  key              String
  sortOrder        Int
  title            String
  why              String
  howTo            String
  examples         String?
  topicSlugs       String[]
  prerequisiteKeys String[]
  showIf           Json?
  contactQuery     Json?
  resources        StepResource[]

  @@unique([pathwayId, key])
}

model StepResource {
  stepId     String
  step       PathwayStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sortOrder  Int         @default(0)

  @@id([stepId, resourceId])
}

/// A saved run of a pathway. No account: accessed by an unguessable token.
model Checklist {
  id             String   @id @default(cuid())
  token          String   @unique
  pathwayId      String
  pathway        Pathway  @relation(fields: [pathwayId], references: [id])
  pathwayVersion Int
  title          String
  answers        Json
  stepState      Json
  community      String?
  lastOpenedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Suggestion {
  id             String           @id @default(cuid())
  targetType     String
  targetId       String?
  message        String
  proposedUrl    String?
  submitterName  String?
  submitterEmail String?
  status         SuggestionStatus @default(OPEN)
  resolvedById   String?
  resolvedBy     User?            @relation("SuggestionResolver", fields: [resolvedById], references: [id])
  resolutionNote String?
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  role           UserRole      @default(EDITOR)
  organizationId String?
  organization   Organization? @relation("OrgMembers", fields: [organizationId], references: [id])
  isActive       Boolean       @default(true)
  lastLoginAt    DateTime?

  maintainedOrgs      Organization[] @relation("OrgMaintainer")
  maintainedRoles     PlayerRole[]   @relation("RoleMaintainer")
  maintainedResources Resource[]     @relation("ResourceMaintainer")
  maintainedPathways  Pathway[]      @relation("PathwayMaintainer")
  maintainedTrails    Trail[]        @relation("TrailMaintainer")
  maintainedAssets    Asset[]        @relation("AssetMaintainer")
  maintainedIssues    Issue[]        @relation("IssueMaintainer")
  resolvedSuggestions Suggestion[]   @relation("SuggestionResolver")
  createdAt           DateTime       @default(now())
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum AssetKind {
  TRAILHEAD
  BRIDGE
  CULVERT
  SIGN
  OTHER
}

enum IssueStatus {
  OPEN
  CLOSED
}

/// A mapped trail. Geometry is also stored in PostGIS column `geom`.
model Trail {
  id      String        @id @default(cuid())
  slug    String        @unique
  name    String
  summary String        @default("")
  status  ContentStatus @default(DRAFT)
  visibility Visibility @default(PUBLIC)
  line    Json
  // TODO(spec): the design doc did not fix the geometry type. A line in WGS84 is the simplest map shape.
  geom    Unsupported("geometry(LineString, 4326)")?

  dataStewardOrgId      String?
  dataSteward           Organization? @relation("TrailDataSteward", fields: [dataStewardOrgId], references: [id])
  maintenanceOwnerOrgId String?
  maintenanceOwner      Organization? @relation("TrailMaintenanceOwner", fields: [maintenanceOwnerOrgId], references: [id])

  maintainerId       String?
  maintainer         User?     @relation("TrailMaintainer", fields: [maintainerId], references: [id])
  reviewedAt         DateTime?
  reviewIntervalDays Int       @default(365)

  assets Asset[]
  issues Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id      String    @id @default(cuid())
  trailId String
  trail   Trail     @relation(fields: [trailId], references: [id], onDelete: Cascade)
  name    String
  kind    AssetKind
  notes   String?
  point   Json
  geom    Unsupported("geometry(Point, 4326)")?

  maintainerId       String?
  maintainer         User?     @relation("AssetMaintainer", fields: [maintainerId], references: [id])
  reviewedAt         DateTime?
  reviewIntervalDays Int       @default(365)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A problem on the ground. ownerOrgId null means nobody owns it yet.
model Issue {
  id          String      @id @default(cuid())
  title       String
  detail      String
  status      IssueStatus @default(OPEN)
  trailId     String?
  trail       Trail?      @relation(fields: [trailId], references: [id])
  ownerOrgId  String?
  ownerOrg    Organization? @relation("IssueOwner", fields: [ownerOrgId], references: [id])

  maintainerId       String?
  maintainer         User?     @relation("IssueMaintainer", fields: [maintainerId], references: [id])
  reviewedAt         DateTime?
  reviewIntervalDays Int       @default(90)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
